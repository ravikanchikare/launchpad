{
  "name": "harnezpad",
  "version": "1.0.0",
  "private": true,
  "description": "HarnezPad is a macOS app that connects coding agents to a team LLM gateway.",
  "scripts": {
    "test": "go test ./... && go vet ./...",
    "verify:sdk": "./scripts/verify-native-sdk-pin.sh",
    "generate:icons": "./scripts/generate-macos-icons.sh assets && ./scripts/generate-provider-pngs.sh assets",
    "frontend:install": "cd frontend && pnpm install --frozen-lockfile",
    "frontend:lint": "cd frontend && pnpm lint",
    "frontend:test": "cd frontend && pnpm test",
    "frontend:build": "./scripts/build-frontend.sh",
    "frontend:verify": "node scripts/verify-frontend-dist.mjs frontend/dist",
    "check:native": "npx --yes @native-sdk/cli@0.7.0 validate app.zon && npx --yes @native-sdk/cli@0.7.0 check && PATH=\"$HOME/.native/toolchains/zig-0.16.0:$PATH\" npx --yes @native-sdk/cli@0.7.0 doctor --manifest app.zon --strict",
    "build:native": "./scripts/build-frontend.sh && npx --yes @native-sdk/cli@0.7.0 build . --yes -Doptimize=ReleaseFast",
    "package:native": "./build-darwin.sh 0.1.0 test native",
    "package:legacy": "./build-darwin.sh 0.1.0 test legacy",
    "verify:package": "./scripts/verify-macos-package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravikanchikare/harnezpad.git"
  },
  "author": "Ravi Kanchikare",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ravikanchikare/harnezpad/issues"
  },
  "homepage": "https://github.com/ravikanchikare/harnezpad#readme"
}
