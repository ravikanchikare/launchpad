.{
    .id = "com.harnezai.launchpad",
    .name = "HarnezPad",
    .display_name = "HarnezPad",
    .description = "HarnezPad is an open-source bridge that instantly connects any coding agent to any LLM provider with zero configuration.",
    .version = "0.7.0",
    .icons = .{"assets/HarnezPadNativeIcon.png"},
    .platforms = .{"macos"},
    .permissions = .{ "view", "command", "network", "clipboard", "window" },
    .capabilities = .{ "native_views", "webview", "js_bridge", "menus", "shortcuts", "tray" },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url = "http://127.0.0.1:5173/",
            .command = .{ "pnpm", "--dir", "frontend", "exec", "vite", "--host", "127.0.0.1" },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .commands = .{
        .{ .id = "harnezpad.open", .title = "Open HarnezPad" },
        .{ .id = "harnezpad.sidebar.toggle", .title = "Toggle Sidebar" },
        .{ .id = "harnezpad.launch", .title = "Launch" },
        .{ .id = "harnezpad.keys", .title = "Keys" },
        .{ .id = "harnezpad.settings", .title = "Settings" },
        .{ .id = "harnezpad.check-updates", .title = "Check for Updates" },
        .{ .id = "harnezpad.quit", .title = "Quit HarnezPad" },
    },
    .shortcuts = .{
        .{ .id = "harnezpad.settings", .key = ",", .modifiers = .{"primary"} },
        .{ .id = "harnezpad.check-updates", .key = "r", .modifiers = .{ "primary", "shift" } },
        .{ .id = "harnezpad.launch", .key = "1", .modifiers = .{"primary"} },
        .{ .id = "harnezpad.keys", .key = "2", .modifiers = .{"primary"} },
    },
    .menus = .{
        .{
            .title = "Navigate",
            .items = .{
                .{ .label = "Launch", .command = "harnezpad.launch", .key = "1", .modifiers = .{"primary"} },
                .{ .label = "Keys", .command = "harnezpad.keys", .key = "2", .modifiers = .{"primary"} },
                .{ .label = "Settings", .command = "harnezpad.settings" },
            },
        },
        .{
            .title = "View",
            .items = .{
                .{ .label = "Check for Updates…", .command = "harnezpad.check-updates", .key = "r", .modifiers = .{ "primary", "shift" } },
            },
        },
    },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "HarnezPad",
                .width = 1030,
                .height = 760,
                .min_width = 840,
                .min_height = 620,
                .restore_state = true,
                .restore_policy = "clamp_to_visible_screen",
                .titlebar = "hidden_inset_tall",
                .close_policy = "hide",
                .views = .{
                    .{
                        .label = "main",
                        .kind = "webview",
                        .fill = true,
                        .layer = 10,
                        .role = "HarnezPad application",
                        .accessibility_label = "HarnezPad",
                        .url = "zero://app",
                    },
                    .{
                        .label = "sidebar-accessory",
                        .kind = "titlebar_accessory",
                        .x = 84,
                        .y = 7,
                        .width = 38,
                        .height = 36,
                        .layer = 30,
                        .role = "Sidebar controls",
                    },
                    .{
                        .label = "sidebar-toggle",
                        .kind = "icon_button",
                        .parent = "sidebar-accessory",
                        .x = 3,
                        .y = 3,
                        .width = 30,
                        .height = 30,
                        .layer = 31,
                        .text = "◧",
                        .command = "harnezpad.sidebar.toggle",
                        .accessibility_label = "Toggle sidebar",
                    },
                    .{
                        .label = "titlebar-drag-sidebar",
                        .kind = "stack",
                        .x = 122,
                        .y = 0,
                        .width = 114,
                        .height = 52,
                        .layer = 29,
                    },
                    .{
                        .label = "titlebar-drag-content",
                        .kind = "stack",
                        .x = 0,
                        .y = 0,
                        .width = 1,
                        .height = 52,
                        .layer = 29,
                        .visible = false,
                    },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{
                "zero://app",
                "http://127.0.0.1:5173",
            },
            .external_links = .{
                .action = "open_system_browser",
                .allowed_urls = .{
                    "https://gateway.example.com/*",
                    "https://github.com/harnezai/harnezpad/*",
                },
            },
        },
    },
    .web_engine = "system",
}
